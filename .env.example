# Discord application OAuth2 credentials.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback

# Comma-separated Discord snowflake IDs. An empty allowlist denies every login.
RECALLIBRATE_ALLOWED_DISCORD_IDS=123456789012345678,234567890123456789

# Assign each invited Discord ID to a server-owned database connection.
# The JSON contains only labels and environment-variable names; URLs remain in
# separate secret variables and are never submitted by a user's browser.
RECALLIBRATE_DATABASE_ASSIGNMENTS={"123456789012345678":{"id":"ash","label":"Ash Memory","database_env":"ASH_DATABASE_URL"}}
ASH_DATABASE_URL=postgresql://dystopian_owner:replace-me@ash-database:5432/postgres

# Legacy mode only. Leave false to prevent users from submitting database URLs.
RECALLIBRATE_ALLOW_SELF_SERVICE_DATABASES=false

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RECALLIBRATE_CREDENTIAL_KEY=

# Persist this path with a mounted volume in production.
RECALLIBRATE_STATE_PATH=/data/recallibrate-state.sqlite3

# Restrict connection URLs to these exact hosts. Strongly recommended in production.
RECALLIBRATE_ALLOWED_DB_HOSTS=127.0.0.1,localhost

# Use false only for local HTTP development. Production HTTPS should always use true.
RECALLIBRATE_SECURE_COOKIES=false
